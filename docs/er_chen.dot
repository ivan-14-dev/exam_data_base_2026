graph Chen {
graph [splines=false, outputorder=edgesfirst, fontname="DejaVu Sans", pad=0.3];
node [fontname="DejaVu Sans", fontsize=12]; edge [fontname="DejaVu Sans", penwidth=1.2];
ATTENDEE [shape=box, style="filled", fillcolor="#DDEBF7", penwidth=1.6, width=1.5, height=0.6, label=<<B>ATTENDEE</B>>, pos="115,360!"];
BOOKING [shape=box, style="filled", fillcolor="#DDEBF7", penwidth=1.6, width=1.5, height=0.6, label=<<B>BOOKING</B>>, pos="475,360!"];
EVENT [shape=box, style="filled", fillcolor="#DDEBF7", penwidth=1.6, width=1.5, height=0.6, label=<<B>EVENT</B>>, pos="835,360!"];
SESSION [shape=box, style="filled", fillcolor="#DDEBF7", penwidth=1.6, width=1.5, height=0.6, label=<<B>SESSION</B>>, pos="835,0!"];
SPEAKER [shape=box, style="filled", fillcolor="#DDEBF7", penwidth=1.6, width=1.5, height=0.6, label=<<B>SPEAKER</B>>, pos="317,0!"];
MAKES [shape=diamond, style="filled", fillcolor="#FCE4D6", penwidth=1.4, width=1.7, height=0.9, label=<<B>Makes</B>>, pos="295,360!"];
CONCERNS [shape=diamond, style="filled", fillcolor="#FCE4D6", penwidth=1.4, width=1.7, height=0.9, label=<<B>Concerns</B>>, pos="655,360!"];
INCLUDES [shape=diamond, style="filled", fillcolor="#FCE4D6", penwidth=1.4, width=1.7, height=0.9, label=<<B>Includes</B>>, pos="835,180!"];
PRESENTS [shape=diamond, style="filled", fillcolor="#FCE4D6", penwidth=1.4, width=1.7, height=0.9, label=<<B>Presents</B>>, pos="576,0!"];
ATTENDEE_attendee_id [shape=ellipse, style=solid, label=<<U>attendee_id</U>>, fontsize=11, pos="7,475!"];
ATTENDEE -- ATTENDEE_attendee_id;
ATTENDEE_first_name [shape=ellipse, style=solid, label="first_name", fontsize=11, pos="115,511!"];
ATTENDEE -- ATTENDEE_first_name;
ATTENDEE_last_name [shape=ellipse, style=solid, label="last_name", fontsize=11, pos="223,475!"];
ATTENDEE -- ATTENDEE_last_name;
ATTENDEE_email [shape=ellipse, style=solid, label="email", fontsize=11, pos="14,252!"];
ATTENDEE -- ATTENDEE_email;
ATTENDEE_phone [shape=ellipse, style=solid, label="phone", fontsize=11, pos="137,238!"];
ATTENDEE -- ATTENDEE_phone;
BOOKING_booking_id [shape=ellipse, style=solid, label=<<U>booking_id</U>>, fontsize=11, pos="374,475!"];
BOOKING -- BOOKING_booking_id;
BOOKING_seats_booked [shape=ellipse, style=solid, label="seats_booked", fontsize=11, pos="475,511!"];
BOOKING -- BOOKING_seats_booked;
BOOKING_amount_paid [shape=ellipse, style=solid, label="amount_paid", fontsize=11, pos="576,475!"];
BOOKING -- BOOKING_amount_paid;
BOOKING_booking_date [shape=ellipse, style=solid, label="booking_date", fontsize=11, pos="475,245!"];
BOOKING -- BOOKING_booking_date;
EVENT_event_id [shape=ellipse, style=solid, label=<<U>event_id</U>>, fontsize=11, pos="734,482!"];
EVENT -- EVENT_event_id;
EVENT_event_name [shape=ellipse, style=solid, label="event_name", fontsize=11, pos="835,518!"];
EVENT -- EVENT_event_name;
EVENT_event_date [shape=ellipse, style=solid, label="event_date", fontsize=11, pos="943,482!"];
EVENT -- EVENT_event_date;
EVENT_location [shape=ellipse, style=solid, label="location", fontsize=11, pos="1001,403!"];
EVENT -- EVENT_location;
EVENT_total_seats [shape=ellipse, style=solid, label="total_seats", fontsize=11, pos="1008,317!"];
EVENT -- EVENT_total_seats;
EVENT_ticket_price [shape=ellipse, style=solid, label="ticket_price", fontsize=11, pos="972,238!"];
EVENT -- EVENT_ticket_price;
EVENT_available_seats [shape=ellipse, style=dashed, label="available_seats", fontsize=11, pos="691,245!"];
EVENT -- EVENT_available_seats;
SESSION_session_id [shape=ellipse, style=solid, label=<<U>session_id</U>>, fontsize=11, pos="979,72!"];
SESSION -- SESSION_session_id;
SESSION_session_title [shape=ellipse, style=solid, label="session_title", fontsize=11, pos="1001,-29!"];
SESSION -- SESSION_session_title;
SESSION_start_time [shape=ellipse, style=solid, label="start_time", fontsize=11, pos="907,-108!"];
SESSION -- SESSION_start_time;
SESSION_end_time [shape=ellipse, style=solid, label="end_time", fontsize=11, pos="763,-108!"];
SESSION -- SESSION_end_time;
SPEAKER_speaker_id [shape=ellipse, style=solid, label=<<U>speaker_id</U>>, fontsize=11, pos="173,94!"];
SPEAKER -- SPEAKER_speaker_id;
SPEAKER_first_name [shape=ellipse, style=solid, label="first_name", fontsize=11, pos="151,-50!"];
SPEAKER -- SPEAKER_first_name;
SPEAKER_last_name [shape=ellipse, style=solid, label="last_name", fontsize=11, pos="317,-108!"];
SPEAKER -- SPEAKER_last_name;
SPEAKER_topic [shape=ellipse, style=solid, label="topic", fontsize=11, pos="454,-94!"];
SPEAKER -- SPEAKER_topic;
ATTENDEE -- MAKES [color="black", label=<<B>1</B>>, fontsize=13];
BOOKING -- MAKES [color="black:invis:black", label=<<B>N</B>>, fontsize=13];
BOOKING -- CONCERNS [color="black:invis:black", label=<<B>N</B>>, fontsize=13];
EVENT -- CONCERNS [color="black", label=<<B>1</B>>, fontsize=13];
EVENT -- INCLUDES [color="black", label=<<B>1</B>>, fontsize=13];
SESSION -- INCLUDES [color="black:invis:black", label=<<B>N</B>>, fontsize=13];
SPEAKER -- PRESENTS [color="black", label=<<B>1</B>>, fontsize=13];
SESSION -- PRESENTS [color="black:invis:black", label=<<B>N</B>>, fontsize=13];
legend [shape=plaintext, pos="497,130!", fontsize=10, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT"><B>Notation (Chen)</B></TD></TR><TR><TD ALIGN="LEFT">Rectangle = entity, Diamond = relationship</TD></TR><TR><TD ALIGN="LEFT">Ellipse = attribute, <U>underlined</U> = primary key</TD></TR><TR><TD ALIGN="LEFT">Dashed ellipse = derived attribute</TD></TR><TR><TD ALIGN="LEFT">Double line = total participation, 1 / N = cardinality</TD></TR></TABLE>>];
}