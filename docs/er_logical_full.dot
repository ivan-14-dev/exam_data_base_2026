digraph Logical {
graph [rankdir=LR, nodesep=0.6, ranksep=1.3, fontname="DejaVu Sans", pad=0.3];
node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=10, penwidth=1.3, dir=both, arrowsize=1.1];
attendees [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>ATTENDEES</B></FONT></TD></TR><TR><TD PORT="attendee_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>attendee_id</U></TD><TD ALIGN="LEFT" PORT="attendee_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="first_name_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="first_name_e"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD PORT="last_name_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="last_name_e"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD PORT="email_w" BGCOLOR="#F2F2F2"><B>UK</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD PORT="phone_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="phone_e"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR></TABLE>>];
speakers [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>SPEAKERS</B></FONT></TD></TR><TR><TD PORT="speaker_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>speaker_id</U></TD><TD ALIGN="LEFT" PORT="speaker_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="first_name_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="first_name_e"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD PORT="last_name_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="last_name_e"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD PORT="topic_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT" PORT="topic_e"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR></TABLE>>];
events [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>EVENTS</B></FONT></TD></TR><TR><TD PORT="event_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>event_id</U></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="event_name_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">event_name</TD><TD ALIGN="LEFT" PORT="event_name_e"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD PORT="event_date_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">event_date</TD><TD ALIGN="LEFT" PORT="event_date_e"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD PORT="location_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT" PORT="location_e"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="total_seats_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">total_seats</TD><TD ALIGN="LEFT" PORT="total_seats_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="available_seats_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">available_seats</TD><TD ALIGN="LEFT" PORT="available_seats_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="ticket_price_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">ticket_price</TD><TD ALIGN="LEFT" PORT="ticket_price_e"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
bookings [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>BOOKINGS</B></FONT></TD></TR><TR><TD PORT="booking_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>booking_id</U></TD><TD ALIGN="LEFT" PORT="booking_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="attendee_id_w" BGCOLOR="#F2F2F2"><B>FK</B></TD><TD ALIGN="LEFT"><I>attendee_id</I></TD><TD ALIGN="LEFT" PORT="attendee_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="event_id_w" BGCOLOR="#F2F2F2"><B>FK</B></TD><TD ALIGN="LEFT"><I>event_id</I></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="seats_booked_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">seats_booked</TD><TD ALIGN="LEFT" PORT="seats_booked_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="amount_paid_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">amount_paid</TD><TD ALIGN="LEFT" PORT="amount_paid_e"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD PORT="booking_date_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">booking_date</TD><TD ALIGN="LEFT" PORT="booking_date_e"><FONT COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
sessions [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>SESSIONS</B></FONT></TD></TR><TR><TD PORT="session_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>session_id</U></TD><TD ALIGN="LEFT" PORT="session_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="event_id_w" BGCOLOR="#F2F2F2"><B>FK</B></TD><TD ALIGN="LEFT"><I>event_id</I></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="speaker_id_w" BGCOLOR="#F2F2F2"><B>FK</B></TD><TD ALIGN="LEFT"><I>speaker_id</I></TD><TD ALIGN="LEFT" PORT="speaker_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="session_title_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">session_title</TD><TD ALIGN="LEFT" PORT="session_title_e"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD PORT="start_time_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT" PORT="start_time_e"><FONT COLOR="#555555">TIME</FONT></TD></TR><TR><TD PORT="end_time_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT" PORT="end_time_e"><FONT COLOR="#555555">TIME</FONT></TD></TR></TABLE>>];
payments [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#C55A11"><FONT COLOR="white"><B>PAYMENTS</B></FONT></TD></TR><TR><TD PORT="payment_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>payment_id</U></TD><TD ALIGN="LEFT" PORT="payment_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="booking_id_w" BGCOLOR="#F2F2F2"><B>FK</B></TD><TD ALIGN="LEFT"><I>booking_id</I></TD><TD ALIGN="LEFT" PORT="booking_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="amount_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT" PORT="amount_e"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD PORT="payment_method_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="LEFT" PORT="payment_method_e"><FONT COLOR="#555555">ENUM</FONT></TD></TR><TR><TD PORT="transaction_ref_w" BGCOLOR="#F2F2F2"><B>UK</B></TD><TD ALIGN="LEFT">transaction_ref</TD><TD ALIGN="LEFT" PORT="transaction_ref_e"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR><TR><TD PORT="status_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#555555">ENUM</FONT></TD></TR><TR><TD PORT="paid_at_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT" PORT="paid_at_e"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
users [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#C55A11"><FONT COLOR="white"><B>USERS</B></FONT></TD></TR><TR><TD PORT="user_id_w" BGCOLOR="#F2F2F2"><B>PK</B></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT" PORT="user_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="attendee_id_w" BGCOLOR="#F2F2F2"><B>FK,UK</B></TD><TD ALIGN="LEFT"><I>attendee_id</I></TD><TD ALIGN="LEFT" PORT="attendee_id_e"><FONT COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD PORT="email_w" BGCOLOR="#F2F2F2"><B>UK</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD PORT="password_hash_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT" PORT="password_hash_e"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD PORT="role_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT" PORT="role_e"><FONT COLOR="#555555">ENUM</FONT></TD></TR><TR><TD PORT="failed_attempts_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">failed_attempts</TD><TD ALIGN="LEFT" PORT="failed_attempts_e"><FONT COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD PORT="locked_until_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">locked_until</TD><TD ALIGN="LEFT" PORT="locked_until_e"><FONT COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD PORT="created_at_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_e"><FONT COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD PORT="last_login_at_w" BGCOLOR="#F2F2F2"> </TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT" PORT="last_login_at_e"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
attendees:attendee_id_e -> bookings:attendee_id_w [arrowtail=teetee, arrowhead=crowodot, label="makes"];
events:event_id_e -> bookings:event_id_w [arrowtail=teetee, arrowhead=crowodot, label="is booked in"];
events:event_id_e -> sessions:event_id_w [arrowtail=teetee, arrowhead=crowtee, label="includes"];
speakers:speaker_id_e -> sessions:speaker_id_w [arrowtail=teetee, arrowhead=crowodot, label="presents"];
bookings:booking_id_e -> payments:booking_id_w [arrowtail=teetee, arrowhead=crowodot, label="is paid by"];
attendees:attendee_id_e -> users:attendee_id_w [arrowtail=teetee, arrowhead=teeodot, label="has account"];
legend [shape=plaintext, fontsize=10, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><B>Notation (crow's foot / IE)</B></TD></TR><TR><TD ALIGN="LEFT">|| exactly one,  o&lt; zero or many,  |&lt; one or many,  o| zero or one</TD></TR><TR><TD ALIGN="LEFT">PK primary key (underlined), FK foreign key (italic), UK unique</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>Blue</B></FONT>: dataset tables   <FONT COLOR="#C55A11"><B>Orange</B></FONT>: additional tables</TD></TR></TABLE>>];
{rank=max; legend;}
}